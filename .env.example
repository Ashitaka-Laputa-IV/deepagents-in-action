# Offline is the default. Select live explicitly in the runner or COURSE_MODE.
# OpenCode Go is the default live provider for notebooks and demos.
# Required: copy this file to .env (git-ignored) and fill in your own key.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/v1
OPENCODE_GO_MODEL=deepseek-v4.1-flash
# Optional stable request/session id; generated per process when omitted.
# OPENCODE_GO_SESSION=

# For another OpenAI-compatible provider, configure all three together.
# These take precedence over OpenCode Go:
# MODEL_API_KEY=
# MODEL_BASE_URL=
# MODEL_NAME=

# Legacy SiliconFlow fallback (only used when no MODEL_* pair is configured):
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# MODEL_NAME=

# Chapter 2 research assistant, live mode only (install with --extra search).
# TAVILY_API_KEY=

# Optional tracing; not required for the local in-memory Agent Server.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=deepagents-course
# Choose ONE endpoint matching your organization's data region (no trailing slash).
# GCP US (SDK default):
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# GCP EU:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# GCP APAC:
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# Required when the API key can access multiple workspaces:
# LANGSMITH_WORKSPACE_ID=
